static func normalize(value:String)->String:
 var code=value.to_lower().replace("-","_").split("_")[0]
 return code if code in LANGS else "en"
static func text(language:String,key:String)->String:
 return TEXT[key][LANGS.find(normalize(language))]
static func items(language:String,key:String)->Array:
 return TEXT[key][LANGS.find(normalize(language))]
static func catalogue_label(language:String,prefix:String,id:String,fallback:String)->String:
 var key=prefix+"_"+id
 return text(language,key) if TEXT.has(key) else fallback
