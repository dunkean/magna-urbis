{
  "name": "magna-urbis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:benches": "vite --mode rustbench --host 127.0.0.1",
    "dev:local": "node scripts/local.mjs dev",
    "start:local": "node scripts/local.mjs dev",
    "build:local": "node scripts/local.mjs build",
    "app:dev": "node scripts/local.mjs desktop-dev",
    "app:build": "node scripts/local.mjs desktop-build",
    "start:benches": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/benches.ps1 start",
    "stop:benches": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/benches.ps1 stop",
    "build:benches": "node scripts/rust_benches.mjs",
    "dev:houses": "node ../rust/scripts/houses.mjs dev",
    "wasm:houses": "node ../rust/scripts/houses.mjs wasm",
    "build:houses": "node ../rust/scripts/houses.mjs build",
    "check:houses": "node ../rust/scripts/houses.mjs check",
    "dev:terrain": "node ../rust/scripts/terrain.mjs dev",
    "wasm:terrain": "node ../rust/scripts/terrain.mjs wasm",
    "build:terrain": "node ../rust/scripts/terrain.mjs build",
    "check:terrain": "node ../rust/scripts/terrain.mjs check",
    "neural:serve": "node ../rust/scripts/terrain.mjs neural",
    "build:neural": "node ../rust/scripts/terrain.mjs neural-build",
    "wasm:neural": "node scripts/neural_wasm.mjs",
    "neural:python": "node scripts/neural_python.mjs",
    "build": "vite build && vite build --mode testbench",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:slow": "vitest run --project slow",
    "typecheck": "tsc --noEmit",
    "preview:png": "tsx scripts/preview.ts",
    "surface:assets": "node scripts/surface_assets.mjs",
    "surface:export": "tsx scripts/export_surface_world.ts",
    "surface:viewer": "node scripts/surface_viewer.mjs",
    "surface:benchmark": "tsx scripts/benchmark_surface.ts",
    "surface:test": "vitest run tests/surface"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "fflate": "^0.8.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}
