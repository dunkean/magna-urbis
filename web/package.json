{
  "name": "magna-urbis",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "illustration:setup": "node scripts/illustration.mjs --setup",
    "illustration:serve": "node scripts/illustration.mjs",
    "illustration:test": "node scripts/illustration_tests.mjs",
    "dev": "vite",
    "dev:v2": "node scripts/v2.mjs dev",
    "build:v2": "node scripts/v2.mjs build",
    "prepare:v2": "node scripts/v2.mjs prepare",
    "dev:v2:local": "node scripts/v2.mjs local",
    "app:v2:dev": "node scripts/v2.mjs desktop-dev",
    "app:v2:build": "node scripts/v2.mjs desktop-build",
    "dev:benches": "vite --mode rustbench --host 127.0.0.1",
    "dev:local": "node scripts/local.mjs dev",
    "start:local": "node scripts/local.mjs dev",
    "build:local": "node scripts/local.mjs build",
    "app:dev": "node scripts/local.mjs desktop-dev",
    "app:build": "node scripts/local.mjs desktop-build",
    "start:benches": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/benches.ps1 start",
    "stop:benches": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/benches.ps1 stop",
    "build:benches": "node scripts/rust_benches.mjs",
    "dev:houses": "node ../rust/scripts/houses.mjs dev",
    "wasm:houses": "node ../rust/scripts/houses.mjs wasm",
    "build:houses": "node ../rust/scripts/houses.mjs build",
    "check:houses": "node ../rust/scripts/houses.mjs check",
    "dev:terrain": "node ../rust/scripts/terrain.mjs dev",
    "wasm:terrain": "node ../rust/scripts/terrain.mjs wasm",
    "wasm:terrain:release": "node ../rust/scripts/terrain.mjs wasm-release",
    "wasm:terrain:threads": "node ../rust/scripts/terrain.mjs wasm-threads",
    "build:terrain": "node ../rust/scripts/terrain.mjs build",
    "check:terrain": "node ../rust/scripts/terrain.mjs check",
    "neural:serve": "node ../rust/scripts/terrain.mjs neural",
    "build:neural": "node ../rust/scripts/terrain.mjs neural-build",
    "wasm:neural": "node scripts/neural_wasm.mjs",
    "neural:python": "node scripts/neural_python.mjs",
    "build": "vite build && vite build --mode testbench",
    "test": "vitest run",
    "test:v2": "vitest run tests/v2",
    "test:v2:browser": "node scripts/v2_browser_check.mjs",
    "test:v2:platform": "node scripts/v2_platform_check.mjs",
    "test:v2:static": "node scripts/v2_static_check.mjs",
    "test:v2:locales": "node scripts/v2_locale_check.mjs",
    "test:v2:urban": "node scripts/v2_rust_urban_check.mjs",
    "test:v2:urban-ui": "node scripts/v2_rust_browser_check.mjs",
    "test:fast": "vitest run --project fast",
    "test:slow": "vitest run --project slow",
    "typecheck": "tsc --noEmit",
    "shaders:wgsl": "tsx scripts/wgsl_shaders.ts",
    "shaders:wgsl:check": "tsx scripts/wgsl_shaders_check.ts",
    "shaders:wgsl:3d": "tsx scripts/wgsl_shaders_3d.ts",
    "preview:png": "tsx scripts/preview.ts",
    "surface:assets": "node scripts/surface_assets.mjs",
    "surface:export": "tsx scripts/export_surface_world.ts",
    "surface:viewer": "node scripts/surface_viewer.mjs",
    "surface:benchmark": "tsx scripts/benchmark_surface.ts",
    "surface:test": "vitest run tests/surface",
    "test:v2:features": "node scripts/v2_feature_check.mjs",
    "test:v2:terrain-controls": "node scripts/v2_terrain_controls_check.mjs",
    "test:v2:terrain-parity": "node scripts/v2_terrain_parity_check.mjs",
    "test:v2:3d": "node scripts/v2_urban_3d_check.mjs",
    "bench:v2:transport": "node --expose-gc --import tsx scripts/v2_transport_bench.ts",
    "bench:v2:picking": "node --import tsx scripts/v2_picking_bench.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "fflate": "^0.8.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}
