"""Offline constructive examples only: no Houses calls and no pose search.

The 054 example preserves the previously admitted facade centre/orientation;
the a702 example uses the longest declared front once. Both keep source ratio.
This does not certify a native portal, roof construction or detailed replay.
"""
import json
import math
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "web/scripts"))
from native_foundation_compare import surface, terrain_bounds, float_bits
from shapely import affinity
from shapely.geometry import box

BASE = ROOT / "web/out/java-source-aspect-proof"
requests = json.loads((BASE / "requests.json").read_bytes())["requests"]
before = json.loads((BASE / "before-plans.json").read_bytes())["buildings"]
after = json.loads((BASE / "after-plans.json").read_bytes())["buildings"]


def world(shape, angle, origin):
    return affinity.translate(affinity.rotate(shape, angle, origin=(0, 0)), *origin)


def inspect(suffix):
    r = next(r for r in requests if suffix in r["id"])
    p = next(p for p in before if p["id"] == r["id"])
    current = next(p for p in after if p["id"] == r["id"])
    domain = surface(r["buildable"])
    result = {"parcel": r["parcel_id"], "recipe": p["recipe_id"],
              "target_m2": r["programme"]["built_area_m2"],
              "ring_vertices": sum(len(s["outer"]) for s in r["buildable"]),
              "hull_excess_m2": domain.convex_hull.difference(domain).area,
              "before_area_m2": surface(p["footprint"]).area,
              "current_area_m2": surface(current["footprint"]).area}
    if suffix not in ("054a9cf4d19f0875", "a7029f26afac0cdd"):
        return result
    target = result["target_m2"]
    eave = p["volumes"][0]["overhang_m"]
    if suffix == "054a9cf4d19f0875":
        # Closest source-valid aspect to the formerly over-wide rectangle.
        w = math.floor(math.sqrt(target * 1.25) * 1000) / 1000
        d = math.ceil(w / 1.25 * 1000 - 1e-9) / 1000
        angle = p["transform"]["orientation_deg"]
        old = float_bits(p["resolved"])
        local = surface(old["surfaces"][old["bodies"][0]["footprint"]])
        xmin, ymin, xmax, ymax = local.bounds
        ox = (xmin + xmax - w) / 2
        oy = ymin
        origin = [p["transform"]["origin"][k] for k in ("x", "y")]
        body = world(box(ox, oy, ox + w, oy + d), angle, origin)
        roof = world(box(ox-eave, oy-eave, ox+w+eave, oy+d+eave), angle, origin)
        result["proposal_basis"] = "single fixed-area ratio correction, old facade centre and orientation"
        # The facade midpoint and its existing public connector stay identical.
        result["old_connector_outside_cadastral_m2"] = surface(p["circulation"]).difference(surface(r["cadastral"])).area
        result["old_connector_body_overlap_m2"] = surface(p["circulation"]).intersection(body).area
    else:
        # Nominal ratio 8/13, not a universal aspect preference.
        w = round(math.sqrt(target * 8/13), 3)
        d = round(target / w, 3)
        access = max(r["accesses"], key=lambda a: math.dist(*[[v[k] for k in ("x", "y")] for v in a["segment"]]))
        a, b = [[v[k] for k in ("x", "y")] for v in access["segment"]]
        origin = [(a[i]+b[i])/2 for i in range(2)]
        angle = math.degrees(math.atan2(b[1]-a[1], b[0]-a[0]))
        local = affinity.rotate(affinity.translate(domain, -origin[0], -origin[1]), -angle, origin=(0,0))
        if local.centroid.y < 0:
            angle += 180
        ox, oy = -w/2, eave + 0.1
        body = world(box(ox, oy, ox+w, oy+d), angle, origin)
        roof = world(box(ox-eave, oy-eave, ox+w+eave, oy+d+eave), angle, origin)
        result["proposal_basis"] = "one centred candidate on longest front, nominal source ratio"
    low, high, slope = terrain_bounds(r["terrain"], body)
    result.update({"dimensions_m": [w, d], "ratio": w/d, "area_m2": body.area,
                   "frame": {"origin": origin, "orientation_deg": angle, "body_origin_local": [ox,oy]},
                   "body_outside_buildable_m2": body.difference(domain).area,
                   "roof_rectangle_outside_roof_domain_m2": roof.difference(surface(r["roof_domain"])).area,
                   "body_overlap_reserves_m2": body.intersection(surface(r["reserves"])).area,
                   "body_overlap_request_neighbors_m2": sum(body.intersection(surface(n["footprint"])).area for n in r["neighbors"]),
                   "terrain": {"low_m": low, "high_m": high, "step_m": high-low, "slope_deg": slope,
                               "max_step_m": r["terrain"]["max_foundation_step_m"]},
                   "native_placement_certified": False,
                   "pending": ["native construction and exact roofs", "native portal/detail replay", "batch occupation index"]})
    if suffix == "054a9cf4d19f0875":
        scale = r["terrain"]["max_foundation_step_m"] / (high-low)
        # One causal estimate, not a dichotomy or a search of native candidates.
        scaled_w = math.floor(w * scale * 1000) / 1000
        scaled_d = math.ceil(max(d * scale, scaled_w / 1.25) * 1000) / 1000
        result["causal_reductions"] = []
        for label, nw, nd in [("uniform_estimate", scaled_w, scaled_d),
                              ("source_ratio_subset_of_old_admitted_body", 7.5, 6.)]:
            nx = (xmin+xmax-nw)/2
            reduced = world(box(nx, ymin, nx+nw, ymin+nd), angle, origin)
            reduced_roof = world(box(nx-eave, ymin-eave, nx+nw+eave, ymin+nd+eave), angle, origin)
            zlo, zhi, grade = terrain_bounds(r["terrain"], reduced)
            result["causal_reductions"].append({"kind": label, "estimated_scale": scale if label == "uniform_estimate" else None,
                "dimensions_m": [nw,nd], "area_m2": reduced.area, "ratio": nw/nd,
                "body_origin_local": [nx,ymin],
                "source_minima_valid": nw>=4.5 and nd>=6,
                "source_ratio_valid": 4.5/11<=nw/nd<=7.5/6,
                "body_outside_buildable_m2": reduced.difference(domain).area,
                "roof_outside_rights_m2": reduced_roof.difference(surface(r["roof_domain"])).area,
                "body_outside_old_admitted_m2": reduced.difference(surface(p["footprint"])).area,
                "body_old_connector_overlap_m2": reduced.intersection(surface(p["circulation"])).area,
                "terrain": {"low_m":zlo,"high_m":zhi,"step_m":zhi-zlo,"slope_deg":grade},
                "native_placement_certified":False})
    return result


report = {"version": "direct-single-fit-offline-examples-1",
          "examples": [inspect(s) for s in ["054a9cf4d19f0875", "a7029f26afac0cdd", "a416b05f397c3d2c", "4100d63eb878ede1", "ae8bc393a4e151bc"]]}
encoded = json.dumps(report, indent=2)
if len(sys.argv) == 2:
    Path(sys.argv[1]).write_text(encoded+"\n", encoding="utf-8")
print(encoded)
