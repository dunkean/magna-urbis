"""At most eight scalar terrain evaluations; no native construction or pose search.

This isolated measurement uses old accepted facade anchors as causal witnesses.
Production does not have these archived answers: a proposed slot would need its
own fixed facade pose first. This is not a placement or interior certificate.
"""
import hashlib
import json
import math
from pathlib import Path
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
INPUTS = {}
sys.path.insert(0, str(ROOT / "web/scripts"))
from native_foundation_compare import surface, terrain_bounds, float_bits
from shapely import affinity
from shapely.geometry import box
from shapely.ops import unary_union


def read(path):
    raw=(ROOT / path).read_bytes()
    INPUTS[path]=hashlib.sha256(raw).hexdigest()
    return json.loads(raw)


def probe(suffix, requests_path, before_path, after_path, ranges):
    requests = read(requests_path)["requests"]
    index, r = next((i,r) for i,r in enumerate(requests) if suffix in r["id"])
    old = next(b for b in read(before_path)["buildings"] if b["id"] == r["id"])
    all_current = {b["id"]: b for b in read(after_path)["buildings"]}
    current = all_current[r["id"]]
    native = float_bits(old["resolved"])
    old_local = surface(native["surfaces"][native["bodies"][0]["footprint"]])
    xmin,ymin,xmax,ymax = old_local.bounds
    cx = (xmin+xmax)/2
    old_w, old_d = xmax-xmin,ymax-ymin
    wmin,wmax,dmin,dmax = ranges
    rmin,rmax = wmin/dmax,wmax/dmin
    desired = min(max(old_w/old_d,rmin),rmax)
    target = old_local.area
    exact_w,exact_d = math.sqrt(target*desired),math.sqrt(target/desired)
    high_ratio = desired == rmax
    # The side rounding is toward the declared aspect interval. Both rounded
    # dimensions are monotone in s; no tolerance is added to ratio/minima.
    def dimensions(s):
        if high_ratio:
            return math.floor(exact_w*s*1000)/1000,math.ceil(exact_d*s*1000)/1000
        return math.ceil(exact_w*s*1000)/1000,math.floor(exact_d*s*1000)/1000
    def world_rect(w,d,margin=0):
        local = box(cx-w/2-margin,ymin-margin,cx+w/2+margin,ymin+d+margin)
        rotated = affinity.rotate(local,old["transform"]["orientation_deg"],origin=(0,0))
        return affinity.translate(rotated,old["transform"]["origin"]["x"],old["transform"]["origin"]["y"])
    minimum_scale = max(wmin/exact_w,dmin/exact_d)
    calls=[]
    def evaluate(s):
        w,d=dimensions(s)
        assert w>=wmin and d>=dmin and rmin<=w/d<=rmax, (s,w,d,rmin,rmax)
        geometry=world_rect(w,d)
        started=time.perf_counter_ns()
        low,high,slope=terrain_bounds(r["terrain"],geometry)
        elapsed=(time.perf_counter_ns()-started)/1e6
        ok=high-low<=r["terrain"]["max_foundation_step_m"] and slope<=12
        row=dict(scale=s,dimensions_m=[w,d],area_m2=w*d,step_m=high-low,slope_deg=slope,terrain_ok=ok,python_audit_ms=elapsed)
        calls.append(row)
        return row
    top=evaluate(1.)
    best=top if top["terrain_ok"] else None
    if best is None:
        bottom=evaluate(minimum_scale)
        if bottom["terrain_ok"]:
            best=bottom
            low,high=minimum_scale,1.
            for _ in range(6):
                mid=(low+high)/2
                result=evaluate(mid)
                if result["terrain_ok"]:
                    low=mid
                    best=result
                else:
                    high=mid
    occupied=[]
    for request in requests[:index]:
        previous=all_current.get(request["id"])
        if previous:
            occupied.extend(surface(previous[k]) for k in ("footprint","courtyards","circulation"))
            occupied.extend(surface(f["surface"]) for f in previous["structural_features"])
    occupied=unary_union(occupied)
    result=dict(parcel=r["parcel_id"],recipe=old["recipe_id"],source_ranges=ranges,
        target_m2=r["programme"]["built_area_m2"],before_area_m2=old_local.area,
        current_area_m2=surface(current["footprint"]).area,
        requested_compatible_dimensions_m=dimensions(1.),
        fixed_old_transform=old["transform"],fixed_facade_local=[cx,ymin],
        calls=calls,call_count=len(calls),best=best,native_constructions=0,
        monotonic_basis="Nested body rectangles at fixed facade centre/front and orientation; fixed bilinear terrain field.",
        limitation="Archived old pose is a causal witness, not an available production result or an optimal anchor.")
    if best:
        w,d=best["dimensions_m"]
        body=world_rect(w,d)
        roof=world_rect(w,d,old["volumes"][0]["overhang_m"])
        result["independent_rights"]={
            "body_outside_buildable_m2":body.difference(surface(r["buildable"])).area,
            "roof_rectangle_outside_roof_domain_m2":roof.difference(surface(r["roof_domain"])).area,
            "body_overlaps_reserves_m2":body.intersection(surface(r["reserves"])).area,
            "body_overlaps_current_previous_occupation_m2":body.intersection(occupied).area,
            "roof_overlaps_current_previous_occupation_m2":roof.intersection(occupied).area,
            "old_connector_body_overlap_m2":surface(old["circulation"]).intersection(body).area,
            "old_connector_outside_cadastral_m2":surface(old["circulation"]).difference(surface(r["cadastral"])).area,
        }
        result["pending"]=["actual native layout/levels and roof projection", "ordinary exact site/access checks", "retained entry and native detailed replay"]
    return result


report={"version":"single-terrain-budget-offline-1","scope":"analysis only; no native calls",
 "examples":[
 probe("054a9cf4d19f0875","web/out/java-source-aspect-proof/requests.json","web/out/java-source-aspect-proof/before-plans.json","web/out/java-source-aspect-proof/after-plans.json",[4.5,7.5,6,11]),
 probe("cbfa2d85b3057462","web/out/strip-initial-budget-proof/requests.json","web/out/native-entry-existing-door-cli-proof/replay/primary-plans.json","web/out/source-aspect-budget-cli-proof/replay/primary-plans.json",[5,9,7,12]),
 ]}
report["inputs_sha256"]=INPUTS
report["script_sha256"]=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
text=json.dumps(report,indent=2)
if len(sys.argv)==2:
    Path(sys.argv[1]).write_text(text+"\n",encoding="utf-8")
print(text)
